name: Daily Portfolio Report

on:
  schedule:
    - cron: "35 20 * * 1-5" # 16:35 EDT
    - cron: "35 21 * * 1-5" # 16:35 EST
  workflow_dispatch:
    inputs:
      dry_run:
        description: "Render report in logs without sending to Telegram or updating data/"
        required: false
        default: false
        type: boolean
      target_date:
        description: "Optional trade date override (YYYY-MM-DD)"
        required: false
        default: ""
        type: string
      force:
        description: "Bypass idempotency and market-close time checks"
        required: false
        default: false
        type: boolean

permissions:
  contents: write

concurrency:
  group: portfolio-daily-report
  cancel-in-progress: false

jobs:
  daily-report:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: "pip"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Run daily portfolio tracker
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          INPUT_DRY_RUN: ${{ inputs.dry_run }}
          INPUT_TARGET_DATE: ${{ inputs.target_date }}
          INPUT_FORCE: ${{ inputs.force }}
        run: |
          ARGS=()
          if [ "${INPUT_DRY_RUN}" = "true" ]; then
            ARGS+=(--dry-run)
          fi
          if [ -n "${INPUT_TARGET_DATE}" ]; then
            ARGS+=(--date "${INPUT_TARGET_DATE}")
          fi
          if [ "${INPUT_FORCE}" = "true" ]; then
            ARGS+=(--force)
          fi
          python -m src.main "${ARGS[@]}"

      - name: Commit updated portfolio state
        if: ${{ inputs.dry_run != true }}
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add data/
          if ! git diff --staged --quiet; then
            git commit -m "chore(data): update daily portfolio NAV [skip ci]"
            git pull --rebase origin "${GITHUB_REF_NAME}"
            git push origin "HEAD:${GITHUB_REF_NAME}"
          else
            echo "No data changes to commit."
          fi
